# KI-Anbieter. Nutzer verbinden ihre eigenen Schlüssel unter Einstellungen → Integrationen → KI verbinden.
# Ein Schlüssel hier gilt serverweit für alle Konten ohne eigenen Schlüssel desselben Anbieters. Leer lassen = nur eigene Schlüssel.
# Reihenfolge ohne Auswahl im Mandanten: Claude, OpenRouter, Requesty, OpenAI.

# Claude (Anthropic direkt)
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Requesty (EU-Region: https://router.eu.requesty.ai/v1)
REQUESTY_API_KEY=
REQUESTY_BASE_URL=https://router.requesty.ai/v1

# OpenAI direkt
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
